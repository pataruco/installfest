# Ghostty configuration
# Install to ~/.config/ghostty/config
# Reload with cmd+shift+, after editing.
# Reference: https://ghostty.org/docs/config/reference

# Font: Monaco 14pt. Monaco has no bold/italic faces; Ghostty synthesises
# them (font-synthetic-style, on by default).
font-family = Monaco
font-size = 14

# Bold text is drawn in the bright palette colours. Starship styles its
# segments as `bold <colour>`, so without this they render in the darker
# normal colours and the prompt looks different.
bold-color = bright

# Terminal theme: built-in Atom One Dark
theme = Atom One Dark

# Fish shell: not needed. Ghostty uses $SHELL / the passwd entry, so
# `chsh -s (which fish)` is enough, and fish shell integration is injected
# automatically. Uncomment only to force fish regardless of login shell.
# command = /opt/homebrew/bin/fish

# tmux: Ghostty has no status bar, so the tmux section of the installfest
# provides CPU/memory/network meters instead. Every new Ghostty window
# attaches to the shared `main` tmux session (creating it if needed).
# Comment this line out to get a plain fish shell instead.
command = /opt/homebrew/bin/tmux new-session -A -s main

# URLs inside tmux: tmux owns the mouse (`mouse on`), so hold Cmd+Shift to
# highlight and click a link there; Shift bypasses tmux's mouse capture for
# one click. Outside tmux, Cmd+click works directly. Nothing to configure.

# Quick terminal: toggles a drop-down terminal window from anywhere with Cmd+`
# (Requires Accessibility permission in macOS System Settings > Privacy & Security > Accessibility)
keybind = global:cmd+grave_accent=toggle_quick_terminal

# SSH integration: automatically sends Ghostty's terminfo to remote hosts via `tic`
# and propagates terminal environment variables, preventing `terminal unknown` errors.
shell-integration-features = ssh-env,ssh-terminfo
